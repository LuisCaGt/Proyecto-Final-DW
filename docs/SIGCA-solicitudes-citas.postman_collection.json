  "item": [
    {
      "name": "1. Datos de apoyo",
      "item": [
        {
          "name": "Opciones (pacientes, profesionales, servicios, horario)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/citas/opciones"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fechas calculadas en cada ejecución (hora de Guatemala, UTC-6).",
                  "const hoy = new Date(Date.now() - 6 * 3600000).toISOString().slice(0, 10);",
                  "const mover = (f, n) => { const d = new Date(f + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };",
                  "const dia = f => new Date(f + 'T12:00:00Z').getUTCDay();",
                  "// Día hábil aleatorio entre 60 y 400 días adelante para no chocar con ejecuciones anteriores.",
                  "let futura = mover(hoy, 60 + Math.floor(Math.random() * 340));",
                  "while (dia(futura) === 0 || dia(futura) === 6) futura = mover(futura, 1);",
                  "let domingo = mover(hoy, 1); while (dia(domingo) !== 0) domingo = mover(domingo, 1);",
                  "pm.collectionVariables.set('hoy', hoy);",
                  "pm.collectionVariables.set('ayer', mover(hoy, -1));",
                  "pm.collectionVariables.set('fechaFutura', futura);",
                  "pm.collectionVariables.set('fechaDomingo', domingo);",
                  "pm.collectionVariables.set('finMes', mover(hoy, 30));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const nombre = p => p.nombres + ' ' + p.apellidos;",
                  "const pac = n => (j.pacientes.find(p => nombre(p) === n) || {})._id || '';",
                  "const prof = n => (j.profesionales.find(p => nombre(p) === n) || {})._id || '';",
                  "const serv = j.servicios.find(s => s.nombre === 'Atención psicológica') || {};",
                  "pm.collectionVariables.set('pacienteAdultoId', pac('Ana Lucía Méndez'));",
                  "pm.collectionVariables.set('pacienteMenorSinRespId', pac('Mateo Ruiz'));",
                  "pm.collectionVariables.set('pacienteInactivoId', pac('Roberto Juárez'));",
                  "pm.collectionVariables.set('profesionalId', prof('Laura Gómez'));",
                  "pm.collectionVariables.set('profesional2Id', prof('Pedro Sandoval'));",
                  "pm.collectionVariables.set('profesionalInactivoId', prof('Andrés Paz'));",
                  "pm.collectionVariables.set('servicioId', serv._id || '');",
                  "pm.collectionVariables.set('servicioPrecio', serv.precioCentavos);",
                  "pm.test('Existen los datos de prueba (ejecuta npm run seed:modulo-citas)', () => ['pacienteAdultoId', 'pacienteMenorSinRespId', 'pacienteInactivoId', 'profesionalId', 'profesional2Id', 'profesionalInactivoId', 'servicioId'].forEach(k => pm.expect(pm.collectionVariables.get(k), k).to.not.be.empty));"
                ]
              }
            }
          ]
        }
      ]
