        "body": {
          "mode": "raw",
          "raw": "{\"identificador\": \"PM-PAC-{{runId}}\", \"nombres\": \"Paciente\", \"apellidos\": \"Prueba Postman\", \"fechaNacimiento\": \"2015-06-15\", \"sexo\": \"FEMENINO\", \"fotografia\": \"/images/persona.svg\", \"telefono\": \"55550002\", \"direccion\": \"Dirección ficticia, Guatemala\", \"fechaInicioProceso\": \"2026-01-01\", \"observacionesAdministrativas\": \"Registro ficticio de pruebas\", \"profesionales\": [\"{{userId}}\"]}",
          "options": {
            "raw": {
