        }
      ]
    },
    {
      "name": "07 Iniciar sesión profesional",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"correo\": \"pm-{{runId}}@sigca.test\", \"password\": \"{{resetPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"professionalToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Profesional no administra usuarios",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/usuarios",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{professionalToken}}",
              "type": "string"
            }
