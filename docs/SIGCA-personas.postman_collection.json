{
  "info": {
    "name": "SIGCA — Autenticación, usuarios, pacientes y responsables",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en una base exclusiva de demostración con seed:all. Configurar password con DEMO_SEED_PASSWORD. El Runner registra datos ficticios únicos, los conserva para demostrar historial y termina desactivando el paciente y usuario creados. No usar con datos reales. Cada ejecución tiene un identificador nuevo. Las contraseñas de prueba son ficticias y configurables."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@sigca.test",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "demoUserPassword",
      "value": "Postman-Prueba-2026!",
      "type": "string"
    },
    {
      "key": "resetPassword",
      "value": "Postman-Restablecida-2026!",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "professionalToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "",
      "type": "string"
    },
    {
      "key": "guardianId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Iniciar sesión administrador",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"correo\": \"{{adminEmail}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", Date.now().toString() + Math.floor(Math.random()*100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Sesión actual",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Sin contraseñas ni hashes\", () => { pm.expect(pm.response.text()).not.to.include(\"passwordHash\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listar usuarios",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/usuarios",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Sin contraseñas ni hashes\", () => { pm.expect(pm.response.text()).not.to.include(\"passwordHash\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Registrar usuario",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/usuarios",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"identificador\": \"PM-USR-{{runId}}\", \"nombres\": \"Profesional\", \"apellidos\": \"Prueba Postman\", \"correo\": \"pm-{{runId}}@sigca.test\", \"telefono\": \"55550001\", \"rol\": \"PROFESIONAL\", \"password\": \"{{demoUserPassword}}\", \"especialidad\": \"Prueba de integración\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"userId\", pm.response.json().id);",
              "pm.test(\"Sin contraseñas ni hashes\", () => { pm.expect(pm.response.text()).not.to.include(\"passwordHash\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Editar usuario",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/usuarios/{{userId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"especialidad\": \"Especialidad actualizada\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
