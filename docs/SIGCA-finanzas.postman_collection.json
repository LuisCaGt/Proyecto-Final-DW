{
  "info": {
    "name": "SIGCA Pagos y caja diaria",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Usar solo datos ficticios y una cuenta de pruebas sin caja previa ni otros movimientos. Obtén token con /api/auth/login. El runner abre y cierra la caja del usuario y crea un abono anulado."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "citaId",
      "value": ""
    },
    {
      "key": "cajaId",
      "value": ""
    },
    {
      "key": "pagoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Abrir caja de demostración",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/cajas/abrir",
        "body": {
          "mode": "raw",
          "raw": "{\"montoInicial\": \"200.00\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar caja actual",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/cajas/actual"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "pm.collectionVariables.set(\"cajaId\",pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Seleccionar cita con saldo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pagos/citas?limite=50"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "const c=pm.response.json().citas.find(c=>c.estado!==\"CANCELADA\" && c.financiero.saldoCentavos>=10000);",
              "pm.test(\"Existe una cita con saldo suficiente\",()=>pm.expect(c).to.exist);",
              "if(c)pm.collectionVariables.set(\"citaId\",c._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Registrar abono Q100",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pagos",
        "body": {
          "mode": "raw",
          "raw": "{\"cita\": \"{{citaId}}\", \"metodo\": \"EFECTIVO\", \"monto\": \"100.00\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([201]));",
              "pm.collectionVariables.set(\"pagoId\",pm.response.json()._id);",
              "pm.test(\"Comprobante único\",()=>pm.expect(pm.response.json().comprobante).to.match(/^SIGCA-/));"
            ]
          }
        }
      ]
    },
    {
      "name": "Comprobante",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pagos/{{pagoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Saldo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/citas/{{citaId}}/saldo"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Historial de cita",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/citas/{{citaId}}/pagos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Listado filtrado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pagos?metodo=EFECTIVO&estado=REGISTRADO"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Rechazar anulación sin motivo",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pagos/{{pagoId}}/anular",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([400]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anular abono de prueba",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pagos/{{pagoId}}/anular",
        "body": {
          "mode": "raw",
          "raw": "{\"motivo\": \"Comprobación con datos ficticios\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Movimientos conservados",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/cajas/{{cajaId}}/movimientos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Cerrar caja sin otros movimientos válidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/cajas/{{cajaId}}/cerrar",
        "body": {
          "mode": "raw",
          "raw": "{\"efectivoContado\": \"200.00\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Rechazar anulación tras cierre",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/pagos/{{pagoId}}/anular",
        "body": {
          "mode": "raw",
          "raw": "{\"motivo\": \"Prueba de bloqueo\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([409]));"
            ]
          }
        }
      ]
    }
  ]
}
