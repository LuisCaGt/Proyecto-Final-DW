    {
      "name": "1. Sesión",
      "item": [
        {
          "name": "Iniciar sesión: administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@sigca.test\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inicia sesión (configura la variable password de la colección)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenAdmin', pm.response.json().token || '');"
                ]
              }
            }
          ]
        },
