    {
      "name": "2. Datos de apoyo",
      "item": [
        {
          "name": "Pacientes (administrador)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pacientes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Código único por ejecución para no chocar con materiales creados antes.",
                  "pm.collectionVariables.set('materialCodigo', 'PM-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const activo = j.find(p => p.identificador === 'PAC-001');",
                  "const inactivo = j.find(p => p.estado === 'INACTIVO');",
                  "pm.collectionVariables.set('pacienteActivoId', activo ? activo.id : '');",
                  "pm.collectionVariables.set('pacienteInactivoId', inactivo ? inactivo.id : '');",
                  "pm.collectionVariables.set('pacientesActivos', JSON.stringify(j.filter(p => p.estado === 'ACTIVO').map(p => p.id)));",
                  "pm.test('Existen pacientes demo (npm run seed:demo)', () => { pm.expect(activo, 'PAC-001').to.exist; pm.expect(inactivo, 'paciente inactivo').to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Pacientes del profesional",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/pacientes",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenProfesional}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const mios = j.map(p => p.id);",
                  "const ajeno = JSON.parse(pm.collectionVariables.get('pacientesActivos') || '[]').find(id => !mios.includes(id));",
                  "pm.collectionVariables.set('pacienteAjenoId', ajeno || '');",
                  "pm.test('El profesional tiene a PAC-001', () => pm.expect(mios).to.include(pm.collectionVariables.get('pacienteActivoId')));"
                ]
              }
            }
          ]
        }
      ]
    },
