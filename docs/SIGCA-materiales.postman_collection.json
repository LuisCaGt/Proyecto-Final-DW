{
  "info": {
    "name": "SIGCA — Materiales de apoyo (RF-09)",
    "description": "Catálogo de materiales, permisos por rol y asignaciones a pacientes. Antes de ejecutar: escribe en la variable `password` de la colección la contraseña de DEMO_SEED_PASSWORD, y carga los datos con `npm run seed:demo` y `npm run seed:materiales`. Ejecuta la colección completa con el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenProfesional",
      "value": ""
    },
    {
      "key": "tokenRecepcion",
      "value": ""
    },
    {
      "key": "materialCodigo",
      "value": ""
    },
    {
      "key": "materialId",
      "value": ""
    },
    {
      "key": "materialInactivoId",
      "value": ""
    },
    {
      "key": "pacienteActivoId",
      "value": ""
    },
    {
      "key": "pacienteInactivoId",
      "value": ""
    },
    {
      "key": "pacienteAjenoId",
